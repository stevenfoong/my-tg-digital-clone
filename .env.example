# Copy to .env on your server and fill in. Never commit .env.

# ---- Bots (add BOT_2_*, BOT_3_* ... for more; all run in one container) ----
BOT_1_TOKEN=123456789:replace-with-token-from-BotFather
# Comma-separated group chat ids this bot should watch (supergroups start with -100).
# Tip: add the bot to a group and it will message you the id.
BOT_1_GROUPS=-1001234567890

# ---- You ----
# Your numeric Telegram user id (e.g. ask @userinfobot)
OWNER_ID=123456789
# Your @username, without the @ (optional)
OWNER_USERNAME=
# Names/nicknames that count as mentioning you, comma-separated (case-insensitive)
OWNER_ALIASES=

# ---- Model (Ollama) ----
LLM_API=ollama
LLM_BASE_URL=https://gemma.example.com
LLM_MODEL=gemma4:e4b
LLM_TIMEOUT=120
# Cloudflare Access service token (leave both empty if not using Access)
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# Any other headers, as JSON, e.g. {"X-Api-Key":"..."}
LLM_EXTRA_HEADERS=
# Set to false if the model "thinks" too long before answering (leave empty if unsure)
LLM_THINK=
LLM_TEMPERATURE=0.6

# ---- Send as me (Telethon, optional) ----
TELETHON_ENABLED=false
# From https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=

# ---- Tuning (defaults are fine) ----
CONTEXT_MESSAGES=30
DEBOUNCE_SECONDS=5
DRAFT_COUNT=3
LEAVE_UNLISTED_GROUPS=false
LOG_LEVEL=INFO
